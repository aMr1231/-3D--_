{
  "name": "twinline",
  "private": true,
  "version": "0.1.0",
  "description": "Twinline — прототип цифрового двойника предприятия и интерактивного 3D-тура (хакатон)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node scripts/backend.mjs serve",
    "setup": "npm install && node scripts/backend.mjs setup",
    "build": "tsc -b && vite build",
    "start": "node scripts/backend.mjs serve",
    "typecheck": "tsc -b",
    "test": "vitest run && node scripts/backend.mjs test",
    "test:web": "vitest run",
    "test:api": "node scripts/backend.mjs test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@xyflow/react": "12.12.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router": "7.18.5",
    "recharts": "3.10.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.19",
    "php": ">=8.3"
  }
}
